generator client {
  provider = "prisma-client-js"
  output   = "./generated-old-client"
}

datasource db {
  provider = "postgresql"
}

model archived_progress {
  id                  Int      @id @default(autoincrement())
  percentage          Int
  date                String   @db.VarChar(100)
  notes               String?
  project_id          Int
  user_name           String   @db.VarChar(100)
  user_role           String   @db.VarChar(30)
  original_created_at DateTime
  archived_at         DateTime @default(now())
  projects            projects @relation(fields: [project_id], references: [id])
}

model attendances {
  id                String           @id @db.Uuid
  userId            Int
  siteId            String           @db.Uuid
  checkInTime       DateTime         @default(now())
  checkOutTime      DateTime?
  checkInLatitude   Float
  checkInLongitude  Float
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkInAccuracy   Float
  checkOutAccuracy  Float?
  durationMinutes   Int?
  status            AttendanceStatus @default(CHECKED_IN)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  sites             sites            @relation(fields: [siteId], references: [id])
  users             users            @relation(fields: [userId], references: [id])

  @@index([checkInTime])
  @@index([checkOutTime])
  @@index([siteId])
  @@index([status])
  @@index([userId])
}

model bills {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  image_url     String?
  image_file_id String?
  amount        Decimal? @db.Decimal(10, 2)
  project_id    Int
  creator_id    Int
  created_at    DateTime @default(now())
  users         users    @relation(fields: [creator_id], references: [id])
  projects      projects @relation(fields: [project_id], references: [id])
}

model materials {
  id               Int              @id @default(autoincrement())
  name             String           @db.VarChar(100)
  quantity         Int
  unit_price       Decimal          @db.Decimal(10, 2)
  description      String?
  image_url        String?
  image_file_id    String?
  request_id       Int
  worker_id        Int?
  payment_requests payment_requests @relation(fields: [request_id], references: [id])
  workers          workers?         @relation(fields: [worker_id], references: [id])

  @@index([worker_id, name])
}

model payment_requests {
  id                                          Int           @id @default(autoincrement())
  status                                      PaymentStatus @default(PENDING_PM)
  total_amount                                Decimal       @db.Decimal(10, 2)
  supervisor_id                               Int
  pm_id                                       Int?
  project_id                                  Int
  created_at                                  DateTime      @default(now())
  updated_at                                  DateTime
  materials                                   materials[]
  users_payment_requests_pm_idTousers         users?        @relation("payment_requests_pm_idTousers", fields: [pm_id], references: [id])
  projects                                    projects      @relation(fields: [project_id], references: [id])
  users_payment_requests_supervisor_idTousers users         @relation("payment_requests_supervisor_idTousers", fields: [supervisor_id], references: [id])
}

model project_progress {
  id         Int      @id @default(autoincrement())
  percentage Int
  date       String   @db.VarChar(100)
  notes      String?
  project_id Int
  user_id    Int
  created_at DateTime @default(now())
  projects   projects @relation(fields: [project_id], references: [id])
  users      users    @relation(fields: [user_id], references: [id])
}

model projects {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(100)
  description       String?
  status            String              @default("ACTIVE") @db.VarChar(20)
  expense_heads     String[]            @default([])
  budget            Decimal?            @db.Decimal(12, 2)
  created_at        DateTime            @default(now())
  archived_progress archived_progress[]
  bills             bills[]
  payment_requests  payment_requests[]
  project_progress  project_progress[]
  reminders         reminders[]
  users             users[]             @relation("ProjectManagers")
}

model reminders {
  id                Int       @id @default(autoincrement())
  amount            Decimal   @db.Decimal(10, 2)
  day_of_month      Int
  frequency         String    @default("MONTHLY") @db.VarChar(20)
  reason            String    @db.VarChar(255)
  is_active         Boolean   @default(true)
  worker_id         Int
  project_id        Int
  last_triggered_at DateTime?
  created_at        DateTime  @default(now())
  projects          projects  @relation(fields: [project_id], references: [id])
  workers           workers   @relation(fields: [worker_id], references: [id])
}

model sites {
  id                                String        @id @db.Uuid
  name                              String
  latitude                          Float
  longitude                         Float
  radius                            Float         @default(30)
  status                            String        @default("ACTIVE")
  createdBy                         Int
  createdAt                         DateTime      @default(now())
  updatedAt                         DateTime
  attendances                       attendances[]
  users_sites_createdByTousers      users         @relation("sites_createdByTousers", fields: [createdBy], references: [id])
  users_users_assignedSiteIdTosites users[]       @relation("users_assignedSiteIdTosites")
}

model users {
  id                                                     Int                @id @default(autoincrement())
  phone                                                  String             @unique @db.VarChar(15)
  dob                                                    String             @db.VarChar(100)
  role                                                   String             @db.VarChar(30)
  name                                                   String?            @db.VarChar(100)
  created_at                                             DateTime           @default(now())
  assignedSiteId                                         String?            @db.Uuid
  attendances                                            attendances[]
  bills                                                  bills[]
  payment_requests_payment_requests_pm_idTousers         payment_requests[] @relation("payment_requests_pm_idTousers")
  payment_requests_payment_requests_supervisor_idTousers payment_requests[] @relation("payment_requests_supervisor_idTousers")
  project_progress                                       project_progress[]
  sites_sites_createdByTousers                           sites[]            @relation("sites_createdByTousers")
  sites_users_assignedSiteIdTosites                      sites?             @relation("users_assignedSiteIdTosites", fields: [assignedSiteId], references: [id])
  projects                                               projects[]         @relation("ProjectManagers")
}

model workers {
  id           Int         @id @default(autoincrement())
  name         String      @db.VarChar(100)
  phone        String?     @db.VarChar(15)
  address      String?
  designation  String?     @db.VarChar(100)
  joining_date DateTime?
  status       String      @default("ACTIVE") @db.VarChar(20)
  notes        String?
  created_at   DateTime    @default(now())
  materials    materials[]
  reminders    reminders[]
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  AUTO_CHECKOUT
  REJECTED
}

enum PaymentStatus {
  PENDING_PM
  PENDING_ADMIN
  PAID
  REJECTED
}
